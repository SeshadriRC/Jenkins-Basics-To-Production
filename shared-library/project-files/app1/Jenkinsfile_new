@Library('my-first-shared-library@main') _
pipeline {
    agent any
    environment {
        REPO = "app1-flask"
        TAG   = "${BUILD_NUMBER}"
        PORT = "5000"
        DOCKERFILE = "shared-library/project-files/app1"
    }

    stages {
        stage('build') {
            steps {
               buildImage() 
            }
        }
        stage('deploy') {
            steps {
deployApp()
            }
        }
    }
}
